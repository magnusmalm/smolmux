# smolmux broker as a systemd user service, one instance per serial port.
#
# Install:
#   cp smolmux@.service.example ~/.config/systemd/user/smolmux@.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now smolmux@ttyUSB0
#
# The instance name (%i) is the device under /dev - smolmux@ttyUSB0 opens
# /dev/ttyUSB0. For stable names use a udev alias (see
# docs/persistent-serial-devices.md). systemd escapes '/' as '-'; %I
# un-escapes it. %t is the user runtime dir (XDG_RUNTIME_DIR).
# ExecStart matches the Pro zip host installer (~/.local/bin). Edit the
# path if you installed somewhere else.

[Unit]
Description=smolmux broker on /dev/%I

[Service]
Type=simple
ExecStart=%h/.local/bin/smolmux /dev/%I -b 115200 -s %t/smolmux-%i.sock
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
